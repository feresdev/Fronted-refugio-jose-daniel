---
const { editing=false, id=null }=Astro.props;
---
<form id="animal-form" class="grid gap-5 md:grid-cols-2"><div><label class="mb-2 block text-sm font-bold">Nombre</label><input name="nombre" class="field" required/></div><div><label class="mb-2 block text-sm font-bold">Raza</label><input name="raza" class="field" required/></div><div><label class="mb-2 block text-sm font-bold">Edad</label><input name="edad" type="number" min="0" class="field" required/></div><div><label class="mb-2 block text-sm font-bold">Sexo</label><select name="sexo" class="field"><option>Hembra</option><option>Macho</option></select></div><div><label class="mb-2 block text-sm font-bold">Tipo de animal</label><select name="tipoAnimal" class="field"><option>Perro</option><option>Gato</option></select></div><div class="md:col-span-2"><p id="form-error" class="error hidden"></p><button class="btn-primary" type="submit">{editing?'Guardar cambios':'Registrar animal'}</button></div></form>
<script define:vars={{editing,id}}>
import {animalSchema} from '../schemas/animal.schema';import {createAnimal,updateAnimal} from '../lib/api/animals.api';const form=document.querySelector('form')!,error=document.querySelector('#form-error')!;form.addEventListener('submit',async e=>{e.preventDefault();const result=animalSchema.safeParse(Object.fromEntries(new FormData(form)));if(!result.success){error.textContent=result.error.issues[0]?.message||'Datos inválidos';error.classList.remove('hidden');return}try{if(editing&&id)await updateAnimal(Number(id),result.data);else await createAnimal(result.data);location.href='/animals'}catch(e){error.textContent=e instanceof Error?e.message:'No se pudo guardar';error.classList.remove('hidden')}})
</script>
