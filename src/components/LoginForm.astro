<form id="login-form" class="space-y-5"><div><label class="mb-2 block text-sm font-bold">Usuario</label><input name="usuario" class="field" maxlength="15" placeholder="feresdev"/></div><div><label class="mb-2 block text-sm font-bold">Contraseña</label><input name="contrasena" type="password" class="field" maxlength="60"/></div><p id="login-error" class="error hidden"></p><button class="btn-primary w-full" type="submit">Ingresar al refugio</button></form>
<script>import {loginSchema} from '../schemas/auth.schema';import {loginRequest} from '../lib/api/auth.api';import {saveToken} from '../lib/auth/storage';const form=document.querySelector('form')!,error=document.querySelector('#login-error')!;form.addEventListener('submit',async e=>{e.preventDefault();const result=loginSchema.safeParse(Object.fromEntries(new FormData(form)));if(!result.success){error.textContent=result.error.issues[0]?.message||'Datos inválidos';error.classList.remove('hidden');return}try{saveToken((await loginRequest(result.data)).token);location.href='/dashboard'}catch(e){error.textContent=e instanceof Error?e.message:'No se pudo iniciar sesión';error.classList.remove('hidden')}})</script>
