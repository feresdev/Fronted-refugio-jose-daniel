<div id="list-status" class="mb-4 text-sm text-slate-500">Cargando animales...</div><div class="overflow-x-auto rounded-2xl bg-white shadow-sm"><table class="w-full min-w-[650px] text-left text-sm"><thead class="bg-ink text-xs uppercase text-white"><tr><th class="px-5 py-4">Nombre</th><th class="px-5 py-4">Raza</th><th class="px-5 py-4">Edad</th><th class="px-5 py-4">Sexo</th><th class="px-5 py-4">Tipo</th><th class="px-5 py-4">Acción</th></tr></thead><tbody id="list-body" class="divide-y divide-slate-100"></tbody></table></div>
<script>import{listAnimals}from'../lib/api/animals.api';import{filtersSchema}from'../schemas/animal.schema';const form=document.querySelector('#filters-form'),status=document.querySelector('#list-status'),body=document.querySelector('#list-body');async function load(){const parsed=filtersSchema.safeParse(Object.fromEntries(new FormData(form||undefined)));if(!parsed.success){status.textContent='Filtros inválidos';return}try{const items=await listAnimals(parsed.data);body.innerHTML=items.map(a=>`<tr><td class="px-5 py-4 font-bold text-ink">${a.nombre}</td><td class="px-5 py-4">${a.raza}</td><td class="px-5 py-4">${a.edad}</td><td class="px-5 py-4">${a.sexo}</td><td class="px-5 py-4">${a.tipoAnimal}</td><td class="px-5 py-4"><a class="font-bold text-ink underline" href="/animals/${a.identificador}/editar">Editar</a></td></tr>`).join('');status.textContent=items.length?`${items.length} registro(s) encontrado(s)`:'No hay animales con esos filtros'}catch(e){status.textContent=e instanceof Error?e.message:'No se pudo cargar la lista'}}form?.addEventListener('submit',e=>{e.preventDefault();load()});load()</script>
