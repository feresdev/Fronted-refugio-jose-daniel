---
import MainLayout from '../../layouts/MainLayout.astro';import AdminNav from '../../components/AdminNav.astro';import AnimalTable from '../../components/AnimalTable.astro';
---
<MainLayout title="Animales"><div class="page-shell min-h-screen"><AdminNav/><main class="mx-auto max-w-7xl px-5 py-10"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-[.25em] text-ink/60">Registros</p><h1 class="display mt-2 text-5xl text-ink">Nuestros animales</h1></div><a href="/animals/nuevo" class="btn-primary">+ Registrar animal</a></div><form id="filters-form" class="mt-8 grid gap-3 rounded-2xl bg-white p-5 sm:grid-cols-2 lg:grid-cols-5"><input name="nombre" class="field" placeholder="Nombre"/><input name="raza" class="field" placeholder="Raza"/><select name="sexo" class="field"><option value="">Todos los sexos</option><option>Hembra</option><option>Macho</option></select><select name="tipoAnimal" class="field"><option value="">Todos los tipos</option><option>Perro</option><option>Gato</option></select><button class="btn-primary" type="submit">Filtrar</button></form><section class="mt-6"><AnimalTable/></section></main></div><script>import{isAuthenticated}from'../../lib/auth/storage';if(!isAuthenticated())location.href='/login'</script></MainLayout>
