---
import MainLayout from '../../../layouts/MainLayout.astro';import AdminNav from '../../../components/AdminNav.astro';import AnimalForm from '../../../components/AnimalForm.astro';
const id=Number(Astro.params.id);
export const prerender = false;
---
<MainLayout title="Editar animal"><div class="page-shell min-h-screen"><AdminNav/><main class="mx-auto max-w-3xl px-5 py-10"><a href="/animals" class="font-bold text-ink">← Volver</a><h1 class="display mt-6 text-5xl text-ink">Editar animal</h1><p id="edit-status" class="mt-2 text-slate-500">Cargando registro...</p><div id="edit-form" class="mt-8 hidden rounded-3xl bg-white p-7 shadow-sm"><AnimalForm editing id={id}/></div></main></div><script>import{isAuthenticated}from'../../../lib/auth/storage';import{getAnimal}from'../../../lib/api/animals.api';if(!isAuthenticated())location.href='/login';const id=Number(location.pathname.split('/')[2]),status=document.querySelector('#edit-status')!,container=document.querySelector('#edit-form')!;try{const animal=await getAnimal(id);for(const[key,value]of Object.entries(animal)){const field=document.querySelector(`[name="${key}"]`)as HTMLInputElement|HTMLSelectElement|null;if(field)field.value=String(value)}status.textContent='Actualiza la información del registro.';container.classList.remove('hidden')}catch(e){status.textContent=e instanceof Error?e.message:'No se pudo cargar el animal'}</script></MainLayout>
