---
import MainLayout from '../layouts/MainLayout.astro';import AdminNav from '../components/AdminNav.astro';
---
<MainLayout title="Panel"><div class="page-shell min-h-screen"><AdminNav/><main class="mx-auto max-w-7xl px-5 py-12"><p class="text-xs font-bold uppercase tracking-[.25em] text-ink/60">Panel de control</p><h1 class="display mt-2 text-5xl text-ink">Hola, administrador.</h1><p class="mt-3 text-slate-500">Gestiona con cariño la información de tus animales.</p><div class="mt-10 grid gap-5 sm:grid-cols-2"><a href="/animals" class="rounded-3xl bg-ink p-8 text-white"><span class="text-4xl">🐾</span><h2 class="display mt-8 text-3xl">Ver animales</h2><p class="mt-2 text-white/70">Consulta y filtra los registros.</p></a><a href="/animals/nuevo" class="rounded-3xl bg-sun p-8 text-ink"><span class="text-4xl">✦</span><h2 class="display mt-8 text-3xl">Registrar animal</h2><p class="mt-2 text-ink/70">Agrega una nueva huella.</p></a></div></main></div><script>import{isAuthenticated}from'../lib/auth/storage';if(!isAuthenticated())location.href='/login'</script></MainLayout>
